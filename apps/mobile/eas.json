{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "12.4.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tabby-split-amber.vercel.app"
      },
      "android": { "credentialsSource": "local" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "apk", "credentialsSource": "local" }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk", "credentialsSource": "local" }
    }
  },
  "submit": {}
}
